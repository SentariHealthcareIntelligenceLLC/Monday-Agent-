{
  "name": "qcms-taskbot",
  "version": "0.1.0",
  "description": "QCMS Task Management + WhatsApp reminder, tracking and escalation service",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node src/db/seed.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test tests/*.test.js",
    "lint": "echo \"no linter configured\" && exit 0",
    "vercel-build": "echo \"no build step\"",
    "gen:schema": "node tools/gen-sqlite-schema.js",
    "check:schema": "node tools/gen-sqlite-schema.js --check"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "license": "MIT"
}
