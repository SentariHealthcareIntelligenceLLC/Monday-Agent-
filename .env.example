# ---- Server ----
PORT=3000
TZ=America/Los_Angeles
NODE_ENV=development
# Password for the admin dashboard (Basic auth user: admin)
ADMIN_PASSWORD=change-me

# ---- WhatsApp Business Cloud API (Meta) ----
# Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User token (permanent) or temporary token for testing
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# You invent this string; paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=qcms-verify-token-change-me
# Meta App Dashboard -> Settings -> Basic -> App Secret (used for X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Approved message template names (see docs/WHATSAPP_SETUP.md)
TEMPLATE_TASK_REMINDER=qcms_task_reminder
TEMPLATE_ESCALATION=qcms_escalation
TEMPLATE_LANG=en_US

# Set true to log outbound messages instead of calling Meta (safe local testing)
DRY_RUN=true

# ---- Scheduling ----
DAILY_REMINDER_CRON=0 8 * * *
MIDDAY_NUDGE_CRON=0 13 * * *
ESCALATION_CRON=0 17 * * *
# Weekly and monthly tasks are included automatically in the daily push
# on the weekday / day-of-month they fall due.

# ---- Data ----
DATABASE_FILE=./data/qcms.sqlite
