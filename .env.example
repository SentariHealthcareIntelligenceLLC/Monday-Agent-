# ---- Server ----
PORT=3000
TZ=America/Los_Angeles
NODE_ENV=development
# Password for the admin dashboard (Basic auth user: admin)
ADMIN_PASSWORD=change-me

# ---- WhatsApp Business Cloud API (Meta) ----
# Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User token (permanent) or temporary token for testing
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# You invent this string; paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=qcms-verify-token-change-me
# Meta App Dashboard -> Settings -> Basic -> App Secret (used for X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Approved message template names (see docs/WHATSAPP_SETUP.md)
TEMPLATE_TASK_REMINDER=qcms_task_reminder
TEMPLATE_ESCALATION=qcms_escalation
TEMPLATE_LANG=en_US

# Set true to log outbound messages instead of calling Meta (safe local testing)
DRY_RUN=true

# ---- Scheduling ----
# On Vercel these are matched against the LOCAL hour in TZ; vercel.json runs the
# cron endpoints hourly and each job no-ops unless its hour matches. In the
# long-running Docker deployment they are used as real cron expressions.
DAILY_REMINDER_CRON=0 8 * * *
MIDDAY_NUDGE_CRON=0 13 * * *
ESCALATION_CRON=0 17 * * *
# Weekly and monthly tasks are included automatically in the daily push
# on the weekday / day-of-month they fall due.

# ---- Data ----
# Leave DATABASE_URL empty to use the local SQLite file (dev / Docker).
DATABASE_FILE=./data/qcms.sqlite

# Set DATABASE_URL to switch to Postgres/Supabase (required on Vercel).
# Supabase -> Project Settings -> Database -> Connection string -> Transaction
# pooler (port 6543). The direct 5432 connection runs out of slots under
# serverless concurrency; use the pooler.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Supabase requires TLS; set false only for a local postgres.
DATABASE_SSL=true

# ---- Vercel Cron ----
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=
